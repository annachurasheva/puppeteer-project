{
  // TASK-0005 · TASK-0100 (m3) · TASK-0162 — настройки workspace (не глобальные prefs).
  "editor.formatOnSave": false,
  "editor.tabSize": 2,
  "files.eol": "\n",

  // Пакет EdgeExtension/ — чистый Vanilla JS: не предлагать сборку/форматирование.
  "files.associations": {
    "*.ps1": "powershell"
  },

  // Не наблюдать тяжёлые каталоги (скорость файлового наблюдателя).
  // Профиль Edge теперь вне репо: .edge_test_* / Edge_test_ok (TASK-0162).
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.edge_test_*/**": true,
    "**/Edge_test_ok/**": true
  },

  // Поиск не заходит в артефакты и профиль Edge.
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.edge_test_*": true,
    "**/Edge_test_ok": true,
    "**/package-lock.json": true
  }
}
